{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "newmovements",
  "account_id": "7ff7737df4a569ad04e6c7c91b607582",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "newmovements.com/*", "zone_name": "newmovements.com" },
    { "pattern": "www.newmovements.com/*", "zone_name": "newmovements.com" }
  ],
  "main": "worker.js",
  "vars": {
    "REAI_BASE_URL": "https://app.reai.no"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "ratelimits": [
    { "name": "ANALYTICS_RATE_LIMIT", "namespace_id": "315712", "simple": { "limit": 60, "period": 60 } },
    { "name": "NEWSLETTER_RATE_LIMIT", "namespace_id": "315710", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHECKOUT_RATE_LIMIT", "namespace_id": "315711", "simple": { "limit": 100, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "build": {
    "command": "node ../../tools/build-assets.mjs",
    "watch_dir": ["public", "../../tools/build-assets.mjs"]
  },
  "previews": {
    "vars": {
      "REAI_MANAGED_PREVIEWS": "true",
      "REAI_PREVIEW_API_BASE_URL": "https://app.reai.no",
      "REAI_BASE_URL": "https://app.reai.no",
      "CHECKOUT_ENABLED": "false"
    }
  }
}
